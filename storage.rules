rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function tenantMatches(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    function canOperateDesk() {
      return request.auth.token.role in ['admin', 'reception'];
    }

    match /tenants/{tenantId}/checkouts/{keyId}/{fileName} {
      allow read: if tenantMatches(tenantId);
      allow write: if tenantMatches(tenantId) && canOperateDesk();
    }
  }
}